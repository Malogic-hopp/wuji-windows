{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wuji/contracts/bridge/v1/bridge.schema.json",
  "title": "WUJI Client Bridge API v1",
  "type": "object",
  "x-wuji-api-version": "1.0",
  "x-wuji-methods": [
    "bridge.hello",
    "client.initialize",
    "agent.getStatus",
    "agent.start",
    "agent.pause",
    "agent.resume",
    "agent.stop",
    "activity.getOverview",
    "activity.getDailyStats",
    "activity.getWeeklyTrend",
    "activity.getTimeline",
    "activity.getHeatmap",
    "settings.get",
    "settings.update",
    "bridge.shutdown"
  ],
  "x-wuji-error-codes": [
    "parse_error",
    "invalid_request",
    "payload_too_large",
    "method_not_found",
    "handshake_required",
    "initialization_required",
    "unsupported_api_version",
    "request_timeout",
    "request_cancelled",
    "validation_failed",
    "internal_error"
  ],
  "$defs": {
    "BridgeErrorKind": {
      "type": "string",
      "enum": [
        "validation",
        "transient",
        "conflict",
        "not_found",
        "unsupported",
        "internal"
      ]
    },
    "BridgeRequestMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "correlationId"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        }
      }
    },
    "BridgeRequestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params",
        "meta"
      ],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "meta": {
          "$ref": "#/$defs/BridgeRequestMeta"
        }
      }
    },
    "BridgeErrorData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "retryable",
        "correlationId"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/BridgeErrorKind"
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SettingsFieldError"
          }
        }
      }
    },
    "BridgeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "data"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/BridgeErrorData"
        }
      }
    },
    "BridgeResponseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id"
      ],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        },
        "error": {
          "$ref": "#/$defs/BridgeError"
        }
      }
    },
    "BridgeHelloParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "BridgeHelloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "bridgeVersion",
        "capabilities"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "bridgeVersion": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ClientInitializeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ClientInitializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "channelName",
        "productDisplayName",
        "isDefaultChannel",
        "capabilities"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "channelName": {
          "type": "string"
        },
        "productDisplayName": {
          "type": "string"
        },
        "isDefaultChannel": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BridgeShutdownParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "BridgeShutdownResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "AgentState": {
      "type": "string",
      "enum": [
        "not_running",
        "starting",
        "running",
        "pausing",
        "paused",
        "resuming",
        "stopping",
        "stopped",
        "stale",
        "error",
        "maintenance"
      ]
    },
    "AgentGetStatusParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actualState",
        "isRunning",
        "isHealthy",
        "isStale"
      ],
      "properties": {
        "actualState": {
          "$ref": "#/$defs/AgentState"
        },
        "isRunning": {
          "type": "boolean"
        },
        "isHealthy": {
          "type": "boolean"
        },
        "isStale": {
          "type": "boolean"
        },
        "lastHeartbeatUtc": {
          "type": "string"
        },
        "lastSampleUtc": {
          "type": "string"
        }
      }
    },
    "AgentStartParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentPauseParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentResumeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentStopParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ActivityGetOverviewParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ActivityDateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 10
        }
      }
    },
    "ActivityGetWeeklyTrendParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ActivityGetHeatmapParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ActivityHourlyBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hour",
        "activeSeconds",
        "idleSeconds",
        "unknownSeconds"
      ],
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "activeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ActivityDailyStatsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "isToday",
        "totalSeconds",
        "activeSeconds",
        "idleSeconds",
        "unknownSeconds",
        "sessionCount",
        "sampleCount",
        "hours"
      ],
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 10
        },
        "isToday": {
          "type": "boolean"
        },
        "totalSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "sessionCount": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "hours": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityHourlyBucket"
          }
        }
      }
    },
    "ActivityTrendDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "isToday",
        "activeSeconds",
        "focusSeconds",
        "contextSwitchCount",
        "sessionCount",
        "topAppName"
      ],
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 10
        },
        "isToday": {
          "type": "boolean"
        },
        "activeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "focusSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "contextSwitchCount": {
          "type": "integer",
          "minimum": 0
        },
        "sessionCount": {
          "type": "integer",
          "minimum": 0
        },
        "topAppName": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "ActivityWeeklyTrendResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "averageActiveSeconds",
        "comparisonToAverageText",
        "comparisonToYesterdayText",
        "weekToDateText"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityTrendDay"
          }
        },
        "averageActiveSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "comparisonToAverageText": {
          "type": "string",
          "maxLength": 256
        },
        "comparisonToYesterdayText": {
          "type": "string",
          "maxLength": 256
        },
        "weekToDateText": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "ActivityTimelineCloseReason": {
      "type": "string",
      "enum": [
        "open",
        "process_changed",
        "paused",
        "stopped",
        "other"
      ]
    },
    "ActivityTimelineSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAtUtc",
        "isOpen",
        "appName",
        "totalSeconds",
        "activeSeconds",
        "idleSeconds",
        "unknownSeconds",
        "closeReason"
      ],
      "properties": {
        "startedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "isOpen": {
          "type": "boolean"
        },
        "appName": {
          "type": "string",
          "maxLength": 128
        },
        "totalSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "closeReason": {
          "$ref": "#/$defs/ActivityTimelineCloseReason"
        }
      }
    },
    "ActivityTimelineGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAtUtc",
        "endedAtUtc",
        "durationSeconds"
      ],
      "properties": {
        "startedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ActivityTimelineResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "isToday",
        "sessions",
        "gaps"
      ],
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 10
        },
        "isToday": {
          "type": "boolean"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityTimelineSession"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityTimelineGap"
          }
        }
      }
    },
    "ActivityHeatmapCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "hour",
        "activeSamples",
        "idleSamples",
        "unknownSamples",
        "activeRatioPercent",
        "intensityLevel"
      ],
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 10
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "activeSamples": {
          "type": "integer",
          "minimum": 0
        },
        "idleSamples": {
          "type": "integer",
          "minimum": 0
        },
        "unknownSamples": {
          "type": "integer",
          "minimum": 0
        },
        "activeRatioPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "intensityLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "ActivityHeatmapResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "today",
        "cells"
      ],
      "properties": {
        "today": {
          "type": "string",
          "maxLength": 10
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityHeatmapCell"
          }
        }
      }
    },
    "ActivityOverviewSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dateUtc",
        "totalDurationSeconds",
        "activeDurationSeconds",
        "idleDurationSeconds",
        "unknownDurationSeconds",
        "sessionCount"
      ],
      "properties": {
        "dateUtc": {
          "type": "string",
          "format": "date-time"
        },
        "totalDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "sessionCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ActivityOverviewApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "totalDurationSeconds",
        "activeDurationSeconds",
        "idleDurationSeconds",
        "unknownDurationSeconds",
        "sessionCount"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "totalDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "sessionCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastUsedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ActivityOverviewSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "startedAtUtc",
        "totalDurationSeconds",
        "activeDurationSeconds",
        "idleDurationSeconds",
        "unknownDurationSeconds"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "startedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "totalDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownDurationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ActivityOverviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "topApps",
        "recentSessions"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/ActivityOverviewSummary"
        },
        "topApps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityOverviewApp"
          }
        },
        "recentSessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityOverviewSession"
          }
        }
      }
    },
    "SettingsTheme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "high_contrast"
      ]
    },
    "SettingsAppSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "refreshIntervalSeconds",
        "autoStartAgentWhenAppStarts"
      ],
      "properties": {
        "theme": {
          "$ref": "#/$defs/SettingsTheme"
        },
        "refreshIntervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "autoStartAgentWhenAppStarts": {
          "type": "boolean"
        }
      }
    },
    "SettingsAgentOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samplingIntervalSeconds",
        "idleThresholdSeconds",
        "heartbeatIntervalSeconds",
        "staleThresholdSeconds",
        "retentionDays",
        "enableJsonlJournal",
        "enableAgentEventJournal",
        "enableSessionMerge",
        "maskWindowTitles"
      ],
      "properties": {
        "samplingIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "idleThresholdSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "staleThresholdSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "enableJsonlJournal": {
          "type": "boolean"
        },
        "enableAgentEventJournal": {
          "type": "boolean"
        },
        "enableSessionMerge": {
          "type": "boolean"
        },
        "maskWindowTitles": {
          "type": "boolean"
        }
      }
    },
    "SettingsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appSettings",
        "agentOptions"
      ],
      "properties": {
        "appSettings": {
          "$ref": "#/$defs/SettingsAppSettings"
        },
        "agentOptions": {
          "$ref": "#/$defs/SettingsAgentOptions"
        }
      }
    },
    "SettingsGetParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "SettingsGetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "defaults"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/SettingsSnapshot"
        },
        "defaults": {
          "$ref": "#/$defs/SettingsSnapshot"
        }
      }
    },
    "SettingsUpdateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/SettingsSnapshot"
        }
      }
    },
    "SettingsUpdateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved",
        "settings"
      ],
      "properties": {
        "saved": {
          "type": "boolean"
        },
        "settings": {
          "$ref": "#/$defs/SettingsSnapshot"
        }
      }
    },
    "SettingsFieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "CommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "completed",
        "actualState",
        "usedFallback"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "actualState": {
          "$ref": "#/$defs/AgentState"
        },
        "usedFallback": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "errorCode": {
          "type": "string"
        }
      }
    }
  }
}
